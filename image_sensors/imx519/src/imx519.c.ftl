static uint32_t IMX519_SetFlip(DRV_IMAGE_SENSOR_OBJ* isensor, DRV_IMAGE_SENSOR_FLIP_MODE mode);
static uint32_t IMX519_GetFormat(DRV_IMAGE_SENSOR_OBJ* isensor, uint8_t* format, uint8_t* bitWidth);

static uint32_t IMX519_SetFlip(DRV_IMAGE_SENSOR_OBJ* isensor, DRV_IMAGE_SENSOR_FLIP_MODE mode) {
    uint8_t regVal = 0;
    bool i2cResult = false;

    if (isensor == NULL) {
        return DRV_IMAGE_SENSOR_ERROR;
    }

    switch (mode) {
        case DRV_IMAGE_SENSOR_FLIP_NONE:
            regVal = 0x00;
            break;
        case DRV_IMAGE_SENSOR_FLIP_HORIZONTAL:
            regVal = 0x01;
            break;
        case DRV_IMAGE_SENSOR_FLIP_VERTICAL:
            regVal = 0x02;
            break;
        case DRV_IMAGE_SENSOR_FLIP_BOTH:
            regVal = 0x03;
            break;
        default:
            return DRV_IMAGE_SENSOR_ERROR;
    }

    i2cResult = DRV_ImageSensor_I2C_WriteReg(isensor, IMX519_IMAGE_ORIENTATION_REG, regVal);

    if (i2cResult == false) {
        return DRV_IMAGE_SENSOR_I2C_ERROR;
    }

    return DRV_IMAGE_SENSOR_SUCCESS;
}

static uint32_t IMX519_GetFormat(DRV_IMAGE_SENSOR_OBJ* isensor, uint8_t* format, uint8_t* bitWidth) {
    uint8_t regValH = 0;
    uint8_t regValL = 0;

    if (isensor == NULL || format == NULL) {
        return DRV_IMAGE_SENSOR_ERROR;
    }

    if (!DRV_ImageSensor_I2C_ReadReg(isensor, 0x0112, &regValH, 1)) {
        return DRV_IMAGE_SENSOR_I2C_ERROR;
    }
    if (!DRV_ImageSensor_I2C_ReadReg(isensor, 0x0113, &regValL, 1)) {
        return DRV_IMAGE_SENSOR_I2C_ERROR;
    }

    *format = DRV_IMAGE_SENSOR_RAW_BAYER;

    if (bitWidth != NULL) {
        if (regValH == 0x0A && regValL == 0x0A) {
            *bitWidth = DRV_IMAGE_SENSOR_10_BIT;
        } else if (regValH == 0x0C && regValL == 0x0C) {
            *bitWidth = DRV_IMAGE_SENSOR_12_BIT;
        } else if (regValH == 0x08 && regValL == 0x08) {
            *bitWidth = DRV_IMAGE_SENSOR_8_BIT;
        } else {
            *bitWidth = DRV_IMAGE_SENSOR_10_BIT;
        }
    }

    return DRV_IMAGE_SENSOR_SUCCESS;
}

